{
  "name": "opencode-brl-cost",
  "version": "0.1.12",
  "description": "OpenCode TUI plugin that shows the session cost in Brazilian Reais (R$)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"

    "opencode-plugin",
    "tui",
    "cost",
    "brl",
    "currency"
  ],
  "license": "AGPL-3.0",
  "author": "oporpino <dev@porpi.no>",
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@opentui/solid": "0.4.5",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.0",
    "typescript": "5.8.2"
  }
